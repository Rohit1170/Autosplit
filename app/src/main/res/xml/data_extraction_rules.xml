<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup + phone-to-phone transfer for Android 12+ (see backup_rules.xml for
  the reasoning; the file lists are the same).

  cloud-backup     -> Google account backup (~daily). Only when it can be
                      end-to-end encrypted with the screen lock.
  device-transfer  -> "Copy apps & data" from the old phone during setup
                      (cable or wireless) — the most reliable way to move.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="splitwise_auto_database" />
        <include domain="database" path="splitwise_auto_database-wal" />
        <include domain="database" path="splitwise_auto_database-shm" />
        <include domain="sharedpref" path="processed_sms.xml" />
        <include domain="sharedpref" path="expense_counter.xml" />
        <include domain="sharedpref" path="active_trip_prefs.xml" />
        <include domain="sharedpref" path="custom_categories.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="splitwise_auto_database" />
        <include domain="database" path="splitwise_auto_database-wal" />
        <include domain="database" path="splitwise_auto_database-shm" />
        <include domain="sharedpref" path="processed_sms.xml" />
        <include domain="sharedpref" path="expense_counter.xml" />
        <include domain="sharedpref" path="active_trip_prefs.xml" />
        <include domain="sharedpref" path="custom_categories.xml" />
    </device-transfer>
</data-extraction-rules>
