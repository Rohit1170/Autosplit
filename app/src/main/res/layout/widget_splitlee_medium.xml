<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_large"
    android:orientation="vertical"
    android:padding="14dp">
    <!-- MEDIUM (default, 4x2): total is the hero; stats in one line; balances below. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_total_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_total_label"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="TOTAL EXPENSES"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_total"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:autoSizeMaxTextSize="34sp"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-black"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="₹0"
                android:textColor="@color/widget_text_primary"
                android:textSize="34sp" />
            <TextView
                android:id="@+id/widget_vs_yesterday"
                android:layout_width="match_parent"
                android:layout_height="17dp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Same as yesterday"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_scan"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_button_bg"
                android:contentDescription="Scan and pay"
                android:padding="9dp"
                android:src="@drawable/ic_widget_scan"
                android:tint="@color/widget_accent" />
            <ImageView
                android:id="@+id/widget_add"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_button_bg"
                android:contentDescription="Add expense"
                android:padding="8dp"
                android:src="@drawable/ic_widget_add"
                android:tint="@color/widget_accent" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_stats"
        android:layout_width="match_parent"
        android:layout_height="17dp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeTextType="uniform"
        android:maxLines="1"
        android:text="0 transactions · ₹0 daily avg"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_owed_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_green"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="9dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_circle_surface"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_widget_arrow_down"
                android:tint="@color/widget_positive" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="15dp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:text="Owed to you"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/widget_owed"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="₹0"
                    android:textColor="@color/widget_positive"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_owe_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_chip_orange"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="9dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_circle_surface"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_widget_arrow_up"
                android:tint="@color/widget_warn" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="15dp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:text="You owe"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/widget_owe"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="₹0"
                    android:textColor="@color/widget_warn"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
