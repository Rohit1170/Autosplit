<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_large"
    android:orientation="vertical"
    android:padding="14dp">
    <!-- SMALL (about 2x2): just the month total and today vs yesterday. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/widget_total_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_total_label"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="TOTAL EXPENSES"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_total"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:autoSizeMaxTextSize="30sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-black"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="₹0"
            android:textColor="@color/widget_text_primary"
            android:textSize="30sp" />
        <TextView
            android:id="@+id/widget_vs_yesterday"
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Same as yesterday"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
