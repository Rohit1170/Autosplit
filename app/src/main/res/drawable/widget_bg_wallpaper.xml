<?xml version="1.0" encoding="utf-8"?>
<!-- Light glassmorphism (RemoteViews can't blur): the same dark green, a bit
     see-through so the wallpaper tints it, a soft light sheen across the top,
     and a thin bright edge like the rim of a glass pane. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Tinted glass body (~90% opaque) -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#E61A2B24" android:endColor="#E60E1613" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Sheen: light falling on the top of the glass -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerY="0.45"
                android:startColor="#1AFFFFFF"
                android:centerColor="#05FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Glass rim -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
