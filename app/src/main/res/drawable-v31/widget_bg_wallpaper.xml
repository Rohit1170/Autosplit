<?xml version="1.0" encoding="utf-8"?>
<!-- Widget theme "wallpaper" (Android 12+): colours come from the wallpaper. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_you_body" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerY="0.45"
                android:startColor="#1AFFFFFF"
                android:centerColor="#05FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="@color/widget_you_rim" />
        </shape>
    </item>
</layer-list>
