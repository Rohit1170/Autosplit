    <color name="widget_text_secondary">#A9B5AF</color>
    <color name="widget_accent">#2FD39A</color>
    <color name="widget_accent_container">#1C3A2F</color>
    <color name="widget_info">#7EA4F5</color>
    <color name="widget_info_container">#22304A</color>

    <color name="widget_positive">#2FD39A</color>
    <color name="widget_positive_container">#16302A</color>
    <color name="widget_warn">#F0A63C</color>
    <color name="widget_warn_container">#33281A</color>
