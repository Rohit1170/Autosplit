<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
      Needed so a location can still be attached to an expense detected from an
      incoming SMS, which is handled by a BroadcastReceiver running in the
      background (the app usually isn't in the foreground when a bank SMS
      arrives). Without this, Android silently withholds location from any
      background component even if foreground location is granted.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      Scan & Pay hands payments to the user's own UPI app via a standard
      upi://pay intent. No phone/call permissions are needed for that path,
      the app never sees the UPI PIN, and it makes no network calls:
      confirmation comes only from the bank's debit SMS (RECEIVE_SMS above).
    -->
    <!--
      Offline "*99#" payment mode: lets a *99# USSD session be dialed with
      one tap instead of opening the phone dialer manually. Optional — if
      this is ever denied, UssdPayHelper falls back to opening the dialer
      pre-filled, which needs no permission at all.
    -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      Android 11+ package visibility: lets Scan & Pay check that at least one
      UPI app can handle a upi://pay link before handing the payment off.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
    </queries>
    <application

        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SplitWiseAuto"
        tools:targetApi="31">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SplitWiseAuto">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ExpenseConfirmationActivity"
            android:exported="false"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true" />
        <activity
            android:name=".ManualExpenseActivity"
            android:exported="false" />
        <activity
            android:name=".ExpenseDetailActivity"
            android:exported="false" />
        <activity
            android:name=".QrScanActivity"
            android:exported="false" />
        <!-- Shares exported CSV files (Data export). grantUriPermissions
             lets the chosen app read the one file we hand it; nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".SmsReceiver"
            android:exported="true">

            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>

        </receiver>
    </application>

</manifest>
